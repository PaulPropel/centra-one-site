---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ArticleHeader from "../../../components/article/ArticleHeader.astro";
import Longform from "../../../components/article/Longform.astro";
import DocLayout from "../../../components/article/DocLayout.astro";
import RelatedCards from "../../../components/article/RelatedCards.astro";
import SupportBlock from "../../../components/help/SupportBlock.astro";
import { getHelpArticles, relatedArticles, type HelpArticle } from "../../../components/help/articles";
import { monthYear } from "../../../components/article/longform";
import { COMPANY, SITE_URL } from "../../../data/site";

export async function getStaticPaths() {
  const articles = await getHelpArticles();
  return articles.map((article) => ({
    params: { category: article.category.slug, slug: article.slug },
    props: { article, all: articles },
  }));
}

interface Props {
  article: HelpArticle;
  all: HelpArticle[];
}
const { article, all } = Astro.props;
const related = relatedArticles(article, all);
const url = `${SITE_URL}${article.url}`;
const categoryUrl = `/help#${article.category.slug}`;

const organisation = {
  "@type": "Organization",
  name: COMPANY.name,
  legalName: COMPANY.legalName,
  url: SITE_URL,
  logo: { "@type": "ImageObject", url: `${SITE_URL}/icon-512.png` },
};
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: article.title,
    description: article.summary,
    dateModified: article.updated,
    articleSection: article.category.title,
    inLanguage: "en-NZ",
    url,
    mainEntityOfPage: { "@type": "WebPage", "@id": url },
    author: organisation,
    publisher: organisation,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Help centre", item: `${SITE_URL}/help` },
      { "@type": "ListItem", position: 2, name: article.category.title, item: `${SITE_URL}${categoryUrl}` },
      { "@type": "ListItem", position: 3, name: article.title, item: url },
    ],
  },
];
---

<BaseLayout
  title={`${article.title} · Centra One help`}
  fullTitle
  description={article.summary}
  jsonLd={jsonLd}
  type="article"
>
  <ArticleHeader
    crumbs={[
      { label: "Help centre", href: "/help" },
      { label: article.category.title, href: categoryUrl },
    ]}
    title={article.title}
    lead={article.summary}
    meta={[`Updated ${monthYear(article.updated)}`, `${article.minutes} min read`]}
  />

  <DocLayout headings={article.headings}>
    <Longform html={article.html} />
  </DocLayout>

  <RelatedCards
    title="Related articles"
    items={related.map((r) => ({ href: r.url, label: r.category.title, title: r.title, meta: `${r.minutes} min read` }))}
  />

  <SupportBlock />
</BaseLayout>
