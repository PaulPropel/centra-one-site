---
// Every page uses this layout: fonts, design system, SEO tags, nav, footer and the
// scroll-reveal fallback for browsers without scroll-driven animations.
import "@fontsource-variable/inter";
import "@fontsource/jetbrains-mono/latin-400.css";
import "@fontsource/jetbrains-mono/latin-500.css";
import "@fontsource/jetbrains-mono/latin-600.css";
import "../styles/global.css";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";

interface Props {
  /** Page title without the brand; " · Centra One" is appended unless fullTitle is set. */
  title: string;
  description: string;
  /** Root-relative or absolute social image. Defaults to the site-wide card. */
  image?: string;
  noindex?: boolean;
  fullTitle?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Numbered footnotes shown at the bottom of the page (referenced with <sup>1</sup>). */
  footnotes?: string[];
  /** Unnumbered fine print shown under the footnotes. */
  notes?: string[];
  type?: "website" | "article";
}

const {
  title,
  description,
  image = "/og.png",
  noindex = false,
  fullTitle = false,
  jsonLd,
  footnotes = [],
  notes = [],
  type = "website",
} = Astro.props;

const site = Astro.site ?? new URL("https://centra-one.ai");
const path = Astro.url.pathname.replace(/\.html$/, "").replace(/\/$/, "") || "/";
const canonical = new URL(path, site).href;
const pageTitle = fullTitle ? title : `${title} · Centra One`;
const ogImage = new URL(image, site).href;
---

<!doctype html>
<html lang="en-NZ">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#05060A" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Centra One changelog" href="/rss.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Centra One" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_NZ" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteNav />
    <main id="main">
      <slot />
    </main>
    <SiteFooter footnotes={footnotes} notes={notes} />
    <script>
      // Scroll reveals for browsers without scroll-driven animations (e.g. Firefox).
      const supportsTimeline = typeof CSS !== "undefined" && CSS.supports("animation-timeline: view()");
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (!supportsTimeline && !reduce && "IntersectionObserver" in window) {
        document.documentElement.classList.add("js-io");
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-in");
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.12 },
        );
        document.querySelectorAll(".rv, .rv2, .rv3").forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
