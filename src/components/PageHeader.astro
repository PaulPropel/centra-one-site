---
// The top of every inner page: eyebrow, H1, lead and optional actions (default slot),
// over the faint blueprint grid and a Centra Blue glow. Clears the floating nav.
//
// `title` may contain simple trusted HTML, e.g. 'Simple pricing.<br><span class="dim">Based on your size.</span>'
// or 'Wholesale. <span class="shine">Handled.</span>'.
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  center?: boolean;
  /** Use the larger display size (homepage-scale headline). */
  large?: boolean;
  class?: string;
}
const { eyebrow, title, lead, center = false, large = false, class: className } = Astro.props;
---

<section class:list={["page-header", "page-top", { center }, className]}>
  <div class="grid-bg" aria-hidden="true"></div>
  <div class="page-header-glow" aria-hidden="true"></div>
  <div class="container relative">
    {eyebrow && <p class="eyebrow in">{eyebrow}</p>}
    <h1 class:list={[large ? "display" : "h1", "in d1", { "mt-24": !!eyebrow }]} set:html={title} />
    {lead && <p class="lead in d2 mt-24">{lead}</p>}
    {
      Astro.slots.has("default") && (
        <div class="page-header-extra in d3 mt-32">
          <slot />
        </div>
      )
    }
  </div>
</section>

<style>
  .page-header {
    position: relative;
    overflow: hidden;
    padding-bottom: clamp(56px, 7vw, 96px);
  }
  .page-header-glow {
    position: absolute;
    pointer-events: none;
    width: 900px;
    height: 640px;
    left: 50%;
    top: -260px;
    margin-left: -450px;
    background: radial-gradient(closest-side, rgba(26, 26, 255, 0.3), rgba(26, 26, 255, 0)),
      radial-gradient(40% 40% at 78% 40%, rgba(167, 139, 250, 0.14), rgba(167, 139, 250, 0));
    filter: blur(8px);
  }
  .page-header:not(.center) .page-header-glow {
    left: 22%;
  }
  .page-header h1 {
    max-width: 980px;
  }
  .page-header.center h1 {
    margin-inline: auto;
  }
  .page-header .lead {
    max-width: 640px;
  }
  .page-header.center .page-header-extra {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
</style>
