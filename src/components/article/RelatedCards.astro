---
// "Related articles" cards at the end of help articles and blog posts.
import Icon from "../Icon.astro";

interface Item {
  href: string;
  /** Small label above the title, e.g. the help topic. */
  label: string;
  title: string;
  /** Mono footnote, e.g. "3 min read". */
  meta: string;
}
interface Props {
  title: string;
  items: Item[];
}
const { title, items } = Astro.props;
const id = `related-${title.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`;
---

{
  items.length > 0 && (
    <section class="related" aria-labelledby={id}>
      <div class="container">
        <h2 id={id} class="related-title">
          {title}
        </h2>
        <div class="grid-auto mt-24">
          {items.map((item) => (
            <a class="related-card" href={item.href}>
              <span class="fine related-label">{item.label}</span>
              <span class="related-name">{item.title}</span>
              <span class="related-foot">
                <span class="fine">{item.meta}</span>
                <Icon name="arrow-right" size={18} />
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .related {
    padding-top: clamp(64px, 8vw, 104px);
  }
  .related-title {
    margin: 0;
    padding-top: 40px;
    border-top: 1px solid var(--line);
    font-size: clamp(26px, 2.6vw, 34px);
    line-height: 1.1;
    letter-spacing: -0.035em;
    font-weight: 700;
  }
  .related-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-height: 180px;
    padding: 24px;
    border-radius: var(--radius-lg);
    background: var(--glass);
    border: 1px solid var(--line);
    color: var(--text);
    transition: border-color 0.3s ease;
  }
  .related-card:hover {
    border-color: rgba(122, 140, 255, 0.55);
    color: var(--text);
  }
  .related-label {
    color: var(--accent-3);
  }
  .related-name {
    font-size: 19px;
    line-height: 1.3;
    letter-spacing: -0.02em;
    font-weight: 700;
  }
  .related-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-top: auto;
    color: var(--accent-3);
  }
  .related-foot .fine {
    color: var(--text-4);
  }
  .related-foot :global(svg) {
    transition: transform 0.3s var(--ease-out);
  }
  .related-card:hover .related-foot :global(svg) {
    transform: translateX(4px);
  }
</style>
