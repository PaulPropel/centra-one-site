---
// "On this page" for long-form pages. The sidebar variant is sticky beside the article on
// wide screens; the inline variant is a <details> above the article on narrow ones.
// One script highlights the section being read in every copy on the page (scroll-spy).
import type { Heading } from "./longform";

interface Props {
  headings: Heading[];
  variant?: "sidebar" | "inline";
  class?: string;
}
const { headings, variant = "sidebar", class: className } = Astro.props;
const items = headings.filter((h) => h.depth === 2);
---

{
  items.length > 1 &&
    (variant === "sidebar" ? (
      <nav class:list={["toc", className]} aria-label="On this page" data-toc>
        <p class="toc-title">On this page</p>
        <ol class="toc-list">
          {items.map((h) => (
            <li>
              <a href={`#${h.slug}`} data-toc-link={h.slug}>
                {h.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    ) : (
      <details class:list={["toc-inline", className]} data-toc>
        <summary>
          <span>On this page</span>
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m6 9 6 6 6-6" />
          </svg>
        </summary>
        <nav aria-label="On this page">
          <ol class="toc-list">
            {items.map((h) => (
              <li>
                <a href={`#${h.slug}`} data-toc-link={h.slug}>
                  {h.text}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      </details>
    ))
}

<style>
  .toc {
    position: sticky;
    top: 112px;
    max-height: calc(100vh - 140px);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .toc-title {
    margin: 0 0 14px;
    font: 500 12px/1.4 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .toc-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-left: 1px solid var(--line-2);
  }
  .toc-list a {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 8px 0 8px 16px;
    font-size: 14px;
    line-height: 1.4;
    color: var(--text-3);
    transition: color 0.25s ease;
  }
  .toc-list a::before {
    content: "";
    position: absolute;
    left: -1px;
    top: 9px;
    bottom: 9px;
    width: 2px;
    border-radius: 2px;
    background: var(--accent-3);
    box-shadow: 0 0 12px rgba(139, 155, 255, 0.8);
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .toc-list a:hover {
    color: var(--text);
  }
  .toc-list a[aria-current="true"] {
    color: var(--text);
  }
  .toc-list a[aria-current="true"]::before {
    opacity: 1;
  }

  .toc-inline {
    border-radius: 18px;
    background: var(--glass-solid);
    border: 1px solid var(--line);
  }
  .toc-inline summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 52px;
    padding: 0 18px;
    cursor: pointer;
    font: 500 12px/1.4 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-2);
  }
  .toc-inline summary::-webkit-details-marker {
    display: none;
  }
  .toc-inline summary svg {
    transition: transform 0.3s var(--ease-out);
  }
  .toc-inline[open] summary svg {
    transform: rotate(180deg);
  }
  .toc-inline nav {
    padding: 0 18px 16px;
  }
  .toc-inline .toc-list a {
    padding: 10px 0 10px 16px;
    font-size: 15px;
  }
</style>

<script>
  const tocs = Array.from(document.querySelectorAll<HTMLElement>("[data-toc]"));
  const links = tocs.flatMap((t) => Array.from(t.querySelectorAll<HTMLAnchorElement>("a[data-toc-link]")));
  const ids = [...new Set(links.map((a) => a.dataset.tocLink ?? ""))];
  const targets = ids.map((id) => document.getElementById(id)).filter((el): el is HTMLElement => el !== null);

  if (targets.length > 1) {
    let current = "";
    let queued = false;

    const setActive = (id: string) => {
      if (id === current) return;
      current = id;
      for (const a of links) {
        if (a.dataset.tocLink === id) a.setAttribute("aria-current", "true");
        else a.removeAttribute("aria-current");
      }
    };

    const update = () => {
      queued = false;
      // The section being read is the last heading above a reading line near the top.
      const line = Math.min(window.innerHeight * 0.3, 240);
      let active = targets[0].id;
      for (const t of targets) {
        if (t.getBoundingClientRect().top <= line) active = t.id;
        else break;
      }
      setActive(active);
    };

    const schedule = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(update);
      }
    };

    window.addEventListener("scroll", schedule, { passive: true });
    window.addEventListener("resize", schedule);
    update();

    // The inline copy folds away after a jump so the reader lands on the section.
    for (const t of tocs) {
      if (t instanceof HTMLDetailsElement) {
        t.addEventListener("click", (e) => {
          if ((e.target as HTMLElement).closest("a")) t.open = false;
        });
      }
    }
  }
</script>
